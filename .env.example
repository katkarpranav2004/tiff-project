# Copy to .env and fill in real values. NEVER commit the real .env.
# Production values go in the host's env settings (Render), not in a file.

# ---- Database (Supabase Postgres) ----------------------------------------
# App runtime: use the POOLED connection (PgBouncer, port 6543).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations only: the DIRECT (non-pooled) connection, port 5432.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- File storage (Supabase Storage) -------------------------------------
# Leave SUPABASE_* empty for local dev to write uploads to ./uploads instead.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server-only secret, never in the client
SUPABASE_BUCKET="uploads"                         # create a PUBLIC bucket with this name

# ---- JWT secrets ----------------------------------------------------------
# Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-48-byte-random"
JWT_REFRESH_SECRET="change-me-different-48-byte-random"

# ---- Server ---------------------------------------------------------------
NODE_ENV="production"
SERVER_PORT=5000
SERVER_URL="https://your-api.onrender.com"

# ---- Client origin(s) for CORS (comma-separated, no trailing slash) -------
CLIENT_URL="https://your-site.vercel.app"

# ---- Uploads (local dev fallback only) ------------------------------------
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760

# ---- Admin seed (creates/resets the admin login) --------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-a-strong-password"
